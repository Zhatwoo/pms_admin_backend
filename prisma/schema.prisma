// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  super_admin
  admin
}

enum AdminUserStatus {
  active
  pending
  suspended
}

enum TenantStatus {
  active
  suspended
  pending
}

enum BillingType {
  monthly
  annual
  both
}

enum BillingCycle {
  monthly
  annual
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
  suspended
  expired
}

enum InvoiceStatus {
  paid
  pending
  failed
}

enum AuditAction {
  create
  update
  delete
  login
  logout
}

/// Platform admin/staff accounts (SaaS-portal operators), linked 1:1 to a Supabase Auth user.
model AdminUser {
  id               String          @id @default(uuid())
  authId           String          @unique @map("auth_id")
  email            String          @unique
  fullName         String          @map("full_name")
  role             AdminRole       @default(admin)
  status           AdminUserStatus @default(active)
  avatarUrl        String?         @map("avatar_url")
  notificationSound String?        @map("notification_sound")
  lastLoginAt      DateTime?       @map("last_login_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("admin_users")
}

/// A subscriber organization/customer of the SaaS platform.
model Tenant {
  id            String         @id @default(uuid())
  name          String
  subdomain     String         @unique
  status        TenantStatus   @default(pending)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  branches      Branch[]
  customers     Customer[]
  users         TenantUser[]
  subscriptions Subscription[]
  client        Client?

  @@map("tenants")
}

/// The corporate/billing entity behind a tenant (contact person, billing address).
model Client {
  id            String   @id @default(uuid())
  tenantId      String   @unique @map("tenant_id")
  companyName   String   @map("company_name")
  contactName   String   @map("contact_name")
  contactEmail  String   @map("contact_email")
  contactPhone  String?  @map("contact_phone")
  billingAddress String? @map("billing_address")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("clients")
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("branches")
}

/// End-user accounts within a tenant's own organization (not platform admins).
model TenantUser {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  email     String
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("tenant_users")
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("customers")
}

model Transaction {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  amount     Decimal  @db.Decimal(12, 2)
  status     String
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model SubscriptionPlan {
  id               String                    @id @default(uuid())
  name             String
  slug             String                    @unique
  description      String?
  isActive         Boolean                   @default(true) @map("is_active")
  visibleOnLanding Boolean                   @default(true) @map("visible_on_landing")
  isDefault        Boolean                   @default(false) @map("is_default")
  isPopular        Boolean                   @default(false) @map("is_popular")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  deletedAt        DateTime?                 @map("deleted_at")

  versions         SubscriptionPlanVersion[]

  @@map("subscription_plans")
}

model SubscriptionPlanVersion {
  id                  String                      @id @default(uuid())
  planId              String                      @map("plan_id")
  versionNumber       Int                         @default(1) @map("version_number")
  monthlyPrice        Decimal                     @db.Decimal(12, 2) @map("monthly_price")
  annualPrice         Decimal                     @db.Decimal(12, 2) @map("annual_price")
  currency            String                      @default("PHP")
  billingType         BillingType                 @default(both) @map("billing_type")
  trialEnabled        Boolean                     @default(false) @map("trial_enabled")
  trialDays           Int                         @default(7) @map("trial_days")
  
  // Limits
  branchLimit         Int                         @default(1) @map("branch_limit")
  userLimit           Int                         @default(5) @map("user_limit")
  storageGb           Decimal                     @default(5.0) @db.Decimal(8, 2) @map("storage_gb")

  isActive            Boolean                     @default(true) @map("is_active")
  createdAt           DateTime                    @default(now()) @map("created_at")

  plan                SubscriptionPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  features            SubscriptionPlanFeature[]
  inclusions          SubscriptionPlanInclusion[]
  addons              SubscriptionPlanAddon[]
  subscriptions       Subscription[]
  history             SubscriptionHistory[]

  @@unique([planId, versionNumber])
  @@map("subscription_plan_versions")
}

model SubscriptionPlanFeature {
  id            String                  @id @default(uuid())
  planVersionId String                  @map("plan_version_id")
  name          String
  enabled       Boolean                 @default(true)
  displayOrder  Int                     @default(0) @map("display_order")

  planVersion   SubscriptionPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@map("subscription_plan_features")
}

model SubscriptionPlanInclusion {
  id            String                  @id @default(uuid())
  planVersionId String                  @map("plan_version_id")
  name          String
  displayOrder  Int                     @default(0) @map("display_order")

  planVersion   SubscriptionPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@map("subscription_plan_inclusions")
}

model SubscriptionPlanAddon {
  id            String                  @id @default(uuid())
  planVersionId String                  @map("plan_version_id")
  name          String
  price         Decimal                 @db.Decimal(12, 2)
  unit          String?
  enabled       Boolean                 @default(true)
  displayOrder  Int                     @default(0) @map("display_order")

  planVersion   SubscriptionPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@map("subscription_plan_addons")
}

model Subscription {
  id            String                  @id @default(uuid())
  tenantId      String                  @map("tenant_id")
  planVersionId String                  @map("plan_version_id")
  status        SubscriptionStatus      @default(trialing)
  billingCycle  BillingCycle            @default(monthly) @map("billing_cycle")
  autoRenew     Boolean                 @default(true) @map("auto_renew")
  startedAt     DateTime                @default(now()) @map("started_at")
  endsAt        DateTime?               @map("ends_at")
  lastPaymentAt DateTime?               @map("last_payment_at")
  
  branchCount   Int                     @default(0) @map("branch_count")
  userCount     Int                     @default(0) @map("user_count")
  storageUsedGb Decimal                 @default(0.0) @db.Decimal(8, 2) @map("storage_used_gb")

  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planVersion   SubscriptionPlanVersion @relation(fields: [planVersionId], references: [id])
  invoices      Invoice[]
  history       SubscriptionHistory[]

  @@map("subscriptions")
}

model SubscriptionHistory {
  id             String                  @id @default(uuid())
  subscriptionId String                  @map("subscription_id")
  planVersionId  String                  @map("plan_version_id")
  action         String
  notes          String?
  createdAt      DateTime                @default(now()) @map("created_at")

  subscription   Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  planVersion    SubscriptionPlanVersion @relation(fields: [planVersionId], references: [id])

  @@map("subscription_history")
}

/// A billing invoice generated for a tenant's subscription period.
model Invoice {
  id             String        @id @default(uuid())
  subscriptionId String        @map("subscription_id")
  tenantId       String        @map("tenant_id")
  amount         Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(pending)
  periodStart    DateTime      @map("period_start")
  periodEnd      DateTime      @map("period_end")
  createdAt      DateTime      @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

/// Immutable trail of admin-initiated actions across the platform.
model AuditLog {
  id           String      @id @default(uuid())
  actorId      String?     @map("actor_id")
  actorEmail   String      @map("actor_email")
  action       AuditAction
  resourceType String      @map("resource_type")
  resourceId   String?     @map("resource_id")
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}

/// Global platform key-value configuration.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}
